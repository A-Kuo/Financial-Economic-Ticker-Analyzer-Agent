# ── NewsAPI ───────────────────────────────────────────────────────────────────
# Get a free key at https://newsapi.org/register  (100 req/day on free tier)
NEWS_API_KEY=your_newsapi_key_here

# ── Ollama ────────────────────────────────────────────────────────────────────
# Default: http://localhost:11434  — change if Ollama runs on a different host/port
OLLAMA_HOST=http://localhost:11434

# Override the model without editing settings.yaml (optional)
# OLLAMA_MODEL=llama3.3
