# ── NewsAPI ──────────────────────────────────────────────────────────────────
# Get a free key at https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# ── Ollama ───────────────────────────────────────────────────────────────────
# Base URL for your local Ollama instance
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/ticker_agent.db

# ── Pipeline Integration (optional) ──────────────────────────────────────────
# Webhook endpoint from FinDocAnalyzer (Stage 1)
FINDOC_WEBHOOK_SECRET=
# Endpoint for Agentic-Visualization-Framework (Stage 3)
VIZ_FRAMEWORK_URL=
VIZ_FRAMEWORK_API_KEY=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/ticker_agent.log
